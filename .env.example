# Application
APP_NAME=DataPilot
APP_ENV=development
DEBUG=true

# API
API_HOST=0.0.0.0
API_PORT=8000

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=datapilot
POSTGRES_USER=datapilot
POSTGRES_PASSWORD=datapilot

# OpenAI
OPENAI_API_KEY=

# Embeddings
EMBEDDING_MODEL=text-embedding-3-small

# LLM
LLM_MODEL=gpt-4o-mini

# RAG
RAG_TOP_K=5
CHUNK_SIZE=800
CHUNK_OVERLAP=120